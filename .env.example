# apps/api
PORT=8080
# Optional. If unset, the API uses an embedded Postgres (PGlite) stored in ./data
DATABASE_URL=
# Optional. If set, WebSocket fan-out uses Redis pub/sub (multi-instance)
REDIS_URL=
JWT_SECRET=change-me
# Comma-separated list of allowed web origins (CORS). "*" in dev.
CORS_ORIGIN=*

# apps/web (build-time)
# Leave empty when the API serves the web build (same origin)
VITE_API_URL=
VITE_AI_URL=
VITE_VOICE_URL=
